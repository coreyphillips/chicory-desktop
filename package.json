{
  "name": "chicory-desktop",
  "version": "0.3.7",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Chicory, a Lightning-first wallet for macOS, Windows and Linux.",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --test web/platform/*.test.ts",
    "check": "npm run typecheck && npm test && npm run test:desktop && npm run test:qualification && npm run test:server && npm run build",
    "test:server": "npm --prefix server test",
    "test:regtest": "node scripts/regtest/payments.ts",
    "test:qualification": "node --test scripts/qualification/*.test.mjs",
    "qualify:regtest": "node scripts/qualification/desktop-regtest.mjs",
    "demo": "npm run build && electron . --demo",
    "web:dev": "vite --host 127.0.0.1",
    "test:desktop": "node --test desktop/*.test.cjs",
    "test:smoke": "node scripts/desktop/smoke.mjs",
    "gallery:build": "vite build --config vite.gallery.config.ts",
    "test:gallery": "npm run gallery:build && node scripts/desktop/gallery.mjs",
    "test:gallery:full": "npm run gallery:build && node scripts/desktop/gallery.mjs --full",
    "runtime:prepare": "node scripts/desktop/prepare-runtime.mjs",
    "package": "npm run build && electron-builder --config build/electron-builder.yml --dir",
    "dist": "npm run build && electron-builder --config build/electron-builder.yml --publish never",
    "release:mac": "node scripts/release/build-mac.mjs",
    "postinstall": "node node_modules/electron/install.js"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@beignet/wallet-core": "github:coreyphillips/beignet-wallet-core#90273846381bbc6775bc5a9a1d27409a18ee0744",
    "@nuintun/qrcode": "5.1.0",
    "@playwright/test": "1.64.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/react-test-renderer": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@zxing/browser": "^0.1.5",
    "buffer": "^6.0.3",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "image-size": "2.1.0",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-qrcode-svg": "^6.3.22",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-svg": "15.15.5",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "react-test-renderer": "^19.2.3",
    "typescript": "^6.0.3",
    "vite": "^7.2.2"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "main": "desktop/main.cjs",
  "author": "Corey Phillips",
  "homepage": "https://github.com/coreyphillips/chicory-desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/coreyphillips/chicory-desktop.git"
  }
}

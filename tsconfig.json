{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": ["vite/client"],
    "paths": {
      "react-native-keychain": ["./web/platform/keychain.ts"],
      "@react-native-clipboard/clipboard": ["./web/platform/clipboard.ts"],
      "react-native-camera-kit": ["./web/platform/cameraKit.tsx"]
    }
  },
  "include": ["web/**/*.ts", "web/**/*.tsx"],
  "exclude": ["web/**/*.test.ts"]
}
